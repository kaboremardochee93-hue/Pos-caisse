<script>
let panier = [];

function ajouterAuPanier(id, nom, prix) {
    const qtyInput = document.getElementById('qty-' + id);
    const qty = parseInt(qtyInput.value) || 1;
    let existe = panier.find(p => p.id === id);
    if (existe) { existe.quantite += qty; } else {
        panier.push({id: id, nom: nom, prix: prix, quantite: qty, coche: true});
    }
    qtyInput.value = 1;
    afficherPanier();
}

function afficherPanier() {
    const container = document.getElementById('listePanier');
    let html = '', tPaye = 0, tAttente = 0, nb = 0;

    if (panier.length === 0) {
        container.innerHTML = '<div class="text-center text-muted py-5">Aucun article sélectionné</div>';
        actualiserTotaux(0, 0, 0);
        return;
    }

    panier.forEach((item, i) => {
        let st = item.prix * item.quantite;
        if (item.coche) tPaye += st; else tAttente += st;
        nb += item.quantite;
        html += `
            <div class="card mb-2 border-0 bg-light ${item.coche ? 'item-paye' : 'item-attente'}">
                <div class="card-body p-2 d-flex align-items-center">
                    <input type="checkbox" class="form-check-input me-2 no-print" ${item.coche ? 'checked' : ''} onchange="basculerCoche(${i})">
                    <div class="flex-grow-1">
                        <div class="fw-bold small">${item.nom}</div>
                        <div class="small text-muted">${item.quantite} x ${item.prix} F</div>
                    </div>
                    <div class="text-end">
                        <div class="fw-bold text-primary small">${st} F</div>
                        <button onclick="supprimer(${i})" class="btn btn-sm text-danger p-0 ms-2 no-print"><i class="fas fa-times"></i></button>
                    </div>
                </div>
            </div>`;
    });
    container.innerHTML = html;
    actualiserTotaux(tPaye, tAttente, nb);
}

function actualiserTotaux(p, a, n) {
    document.getElementById('total').innerText = p.toLocaleString() + ' F';
    document.getElementById('totalPrint').innerText = p.toLocaleString();
    document.getElementById('totalAttente').innerText = a.toLocaleString() + ' F';
    document.getElementById('nbArticles').innerText = n;
}

function basculerCoche(i) { panier[i].coche = !panier[i].coche; afficherPanier(); }
function supprimer(i) { panier.splice(i, 1); afficherPanier(); }
function viderPanier() { if (confirm('Voulez-vous vider le panier actuel ?')) { panier = []; afficherPanier(); } }

function validerVentePartielle() {
    let paye = panier.filter(p => p.coche);
    let reste = panier.filter(p => !p.coche);

    if (paye.length === 0) return alert("Veuillez cocher les produits que le client paie maintenant.");

    if (!confirm("Enregistrer la vente et lancer l'impression ?")) return;

    fetch('valider_vente.php', {
        method: 'POST',
        headers: {'Content-Type': 'application/x-www-form-urlencoded'},
        body: 'panier=' + encodeURIComponent(JSON.stringify(paye))
    }).then(response => {
        window.print();
        if (reste.length > 0) {
            let client = prompt("Des articles n'ont pas été payés. Nom du client pour les mettre en attente ?", "Client_" + Math.floor(Math.random()*1000));
            if (client) sauvegarderAttente(client, reste);
        }
        panier = [];
        afficherPanier();
        alert("Vente enregistrée avec succès !");
    });
}

function mettreToutEnAttente() {
    if (panier.length === 0) return alert("Le panier est vide.");
    let client = prompt("Mettre tout le panier en attente. Nom du client ?");
    if (client) sauvegarderAttente(client, panier);
}

function sauvegarderAttente(client, liste) {
    let formData = new URLSearchParams();
    formData.append('client', client);
    formData.append('panier', JSON.stringify(liste));

    fetch('mettre_en_attente.php', {
        method: 'POST',
        headers: {'Content-Type': 'application/x-www-form-urlencoded'},
        body: formData.toString()
    }).then(() => {
        panier = [];
        afficherPanier();
        chargerAttente();
    });
}

function chargerAttente() {
    const corps = document.getElementById('corpsAttente');
    corps.innerHTML = '<div class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x"></i><br>Chargement...</div>';

    fetch('get_attente.php')
    .then(r => r.json())
    .then(data => {
        let html = ''; 

        if (data.length === 0) {
            html = '<div class="alert alert-info">Aucun article en attente.</div>';
        } else {
            data.forEach((p) => {
                // Génération de la liste détaillée des produits
                let listeProduits = '<ul class="wait-details">';
                p.items.forEach(it => {
                    listeProduits += `<li><i class="fas fa-check-circle text-warning me-1"></i> ${it.nom} (x${it.quantite})</li>`;
                });
                listeProduits += '</ul>';

                html += `
                <div class="card mb-3 border-0 shadow-sm bg-light">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <span class="fw-bold text-primary" style="font-size: 1.1rem;">${p.client}</span><br>
                                <small class="text-muted"><i class="far fa-clock"></i> ${p.date}</small>
                                ${listeProduits}
                            </div>
                            <button onclick="reprendrePanier(${p.id_db})" class="btn btn-sm btn-warning rounded-pill px-3 shadow-sm fw-bold" data-bs-dismiss="modal">
                                REPRENDRE
                            </button>
                        </div>
                    </div>
                </div>`;
            });
        }
        corps.innerHTML = html;
    })
    .catch(err => {
        console.error(err);
        corps.innerHTML = '<div class="alert alert-danger">Erreur lors de la récupération des données.</div>';
    });
}

function reprendrePanier(id_db) {
    fetch('reprendre_panier.php?index=' + id_db)
    .then(r => r.json()).then(data => {
        panier = data.map(it => ({ ...it, coche: true }));
        afficherPanier();
        chargerAttente(); // Rafraîchir la liste après reprise
    });
}

function filterProducts() {
    let input = document.getElementById('searchInput').value.toLowerCase();
    document.querySelectorAll('.product-item').forEach(item => {
        item.style.display = item.getAttribute('data-name').includes(input) ? "block" : "none";
    });
}

window.onload = () => { chargerAttente(); afficherPanier(); };
</script>
